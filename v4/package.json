{
  "name": "lookism-system-v4",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "turbo dev",
    "build": "corepack pnpm -r --if-present build",
    "check": "corepack pnpm -r --if-present check",
    "test": "vitest run",
    "web:dev": "pnpm --filter web dev",
    "web:build": "pnpm --filter web build",
    "mobile:start": "pnpm --filter mobile start"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^4.1.0"
  }
}
